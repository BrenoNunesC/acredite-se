# Copie para .env (o .env fica fora do Git) e ajuste o que quiser.

# IA — Groq (grátis): crie a chave em https://console.groq.com → API Keys
AI_KEY=
# AI_MODEL=llama-3.3-70b-versatile
# AI_URL=https://api.groq.com/openai/v1

# Portas no seu computador
APP_PORT=8080
DB_PORT=3307

# Banco de dados
DB_NAME=acredite
DB_USER=acredite
DB_PASS=acredite
DB_ROOT_PASS=root

# true mostra o código de recuperação de senha na tela (só para testes)
DEBUG=true
